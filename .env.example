# Database (Neon PostgreSQL Free Tier connection string)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/rudrakart?sslmode=require"

# NextAuth / Auth.js
NEXTAUTH_SECRET="generate-a-unique-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY_DEFAULT="NPR"
NEXT_PUBLIC_USD_RATE="135.0"

# Image Storage (Optional Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo-rudrakart"

# Transactional Email Notification System (Gmail SMTP or Resend)
# Option A: Genuine Gmail delivery straight to your real inbox:
# 1. Enable 2-Step Verification in your Google Account (Security tab)
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
TEST_EMAIL_RECIPIENT=""

# Option B: Resend transactional email provider
EMAIL_MODE="development"
RESEND_API_KEY=""
EMAIL_FROM="RudraKart Orders <orders@rudrakart.com>"
SHIPPING_PARTNER_EMAIL="supranjal777@gmail.com"

# WhatsApp confirmation delivery (free Meta test number)
# Create a Meta developer app, add WhatsApp, then verify your real number
# under WhatsApp > API Setup as a test recipient. Use the test number's
# Phone Number ID and temporary access token below. Phone numbers entered at
# checkout must include the country code, for example +9779841234567.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v20.0"

# Transaction Cryptographic Signing Keys (RSA-SHA256 2048-bit)
# Run `npx tsx scripts/generate-keys.ts` to generate new keypairs.
# Both Base64-encoded strings and multiline PEM format are supported.
# If left blank in development, an in-memory keypair is auto-initialized.
TRANSACTION_SIGNING_PRIVATE_KEY=""
TRANSACTION_SIGNING_PUBLIC_KEY=""
