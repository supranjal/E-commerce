<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <radialGradient id="sacredGold" cx="50%" cy="35%" r="60%">
      <stop offset="0%" stop-color="#FCD34D" />
      <stop offset="45%" stop-color="#D97706" />
      <stop offset="90%" stop-color="#78350F" />
      <stop offset="100%" stop-color="#451A03" />
    </radialGradient>
    <filter id="divineGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#D97706" flood-opacity="0.5"/>
    </filter>
  </defs>
  <rect width="64" height="64" rx="14" fill="#1C140E"/>
  <circle cx="32" cy="32" r="26" fill="none" stroke="#D97706" stroke-width="1.5" stroke-dasharray="3 2" opacity="0.6"/>
  <!-- Rudraksha Seed Contour -->
  <path d="M 32 10 C 44 10 52 18 52 32 C 52 46 44 54 32 54 C 20 54 12 46 12 32 C 12 18 20 10 32 10 Z" fill="url(#sacredGold)" filter="url(#divineGlow)"/>
  <!-- Sacred Mukhi Ridges -->
  <path d="M 32 10 Q 34 32 32 54" stroke="#FFFBEB" stroke-width="2" stroke-linecap="round" opacity="0.85"/>
  <path d="M 32 10 Q 42 30 32 54" stroke="#451A03" stroke-width="1.8" stroke-linecap="round" opacity="0.75"/>
  <path d="M 32 10 Q 22 30 32 54" stroke="#451A03" stroke-width="1.8" stroke-linecap="round" opacity="0.75"/>
  <path d="M 32 10 Q 48 32 32 54" stroke="#78350F" stroke-width="1.5" opacity="0.6"/>
  <path d="M 32 10 Q 16 32 32 54" stroke="#78350F" stroke-width="1.5" opacity="0.6"/>
  <!-- Central Bindu Sparkle -->
  <circle cx="32" cy="32" r="3.5" fill="#FEF3C7"/>
  <circle cx="32" cy="32" r="1.5" fill="#B45309"/>
</svg>
